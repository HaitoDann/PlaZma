{
  "name": "archi-client",
  "version": "0.14.0",
  "private": true,
  "description": "Client local ARCHI (Windows) : rang SoloQ, import .rofl, historique SoloQ — sans clé Riot.",
  "bin": "archi-client.js",
  "scripts": {
    "start": "node archi-client.js",
    "test:rofl": "node test-rofl.js",
    "test": "node test-analyse.js",
    "check:rofl": "node -e \"const f=require('fs');if(f.readFileSync('rofl.js','utf8')!==f.readFileSync('../assets/rofl-browser.js','utf8')){console.error('rofl.js et assets/rofl-browser.js divergent');process.exit(1)}\"",
    "build": "pkg . --targets node20-win-x64 --output dist/archi-client.exe"
  },
  "pkg": {
    "scripts": [
      "rofl.js",
      "timeline.js",
      "push.js",
      "auto-scrim.js",
      "ui.js",
      "ui-page.js",
      "tray.js"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
